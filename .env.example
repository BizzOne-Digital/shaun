# Monsterous Radio — local environment
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# ── Streaming (optional) ──────────────────────────────────────────
NEXT_PUBLIC_RADIO_STREAM_URL=
NEXT_PUBLIC_RADIO_METADATA_URL=
NEXT_PUBLIC_LEGACY_PLAYER_URL=

# ── Gmail SMTP (forms: contact / advertising / newsletter) ────────
# 1. Enable 2-Step Verification on the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password into SMTP_PASS (spaces ok)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sbyoung2000@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# From must be the same Gmail address (Gmail rejects arbitrary From)
CONTACT_FROM_EMAIL=sbyoung2000@gmail.com
CONTACT_FROM_NAME=Monsterous Radio Website

# Where form submissions are delivered
CONTACT_TO_EMAIL=sbyoung2000@gmail.com
